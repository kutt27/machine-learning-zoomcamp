    "            \"notifications\": [\"slack\"]\n",
    "        },\n",
    "        {\n",
    "            \"name\": \"Low Request Rate\",\n",
    "            \"condition\": \"requests_per_second < 0.1\",\n",
    "            \"duration\": \"10m\",\n",
    "            \"severity\": \"info\",\n",
    "            \"notifications\": [\"email\"]\n",
    "        }\n",
    "    ]\n",
    "}\n",
    "\n",
    "with open('monitoring-config.json', 'w') as f:\n",
    "    json.dump(monitoring_config, f, indent=2)\n",
    "\n",
    "print(\"✅ Monitoring configuration created!\")"
