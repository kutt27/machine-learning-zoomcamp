   "source": [
    "# ☁️ Cloud Deployment Walkthrough\n",
    "\n",
    "> **Deploy machine learning models to cloud platforms**\n",
    "\n",
    "This notebook provides comprehensive guidance for deploying ML models to major cloud platforms including AWS, Google Cloud, and Azure.\n",
    "\n",
    "## 🎯 Learning Objectives\n",
    "\n",
    "By the end of this notebook, you will:\n",
    "- **Deploy** models to AWS, GCP, and Azure\n",
    "- **Configure** auto-scaling and load balancing\n",
    "- **Implement** CI/CD pipelines for ML models\n",
    "- **Monitor** deployed models in production\n",
    "- **Handle** model versioning and rollbacks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import yaml\n",
    "import boto3\n",
    "import requests\n",
    "from datetime import datetime\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "print(\"✅ All imports successful!\")\n",
    "print(\"☁️ This notebook covers cloud deployment strategies\")\n",
    "print(\"🔑 Make sure you have cloud credentials configured\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🚀 AWS Deployment with ECS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create AWS ECS task definition\n",
    "ecs_task_definition = {\n",
    "    \"family\": \"ml-api-task\",\n",
    "    \"networkMode\": \"awsvpc\",\n",
    "    \"requiresCompatibilities\": [\"FARGATE\"],\n",
    "    \"cpu\": \"256\",\n",
    "    \"memory\": \"512\",\n",
    "    \"executionRoleArn\": \"arn:aws:iam::YOUR_ACCOUNT:role/ecsTaskExecutionRole\",\n",
    "    \"containerDefinitions\": [\n",
    "        {\n",
    "            \"name\": \"ml-api-container\",\n",
    "            \"image\": \"YOUR_ACCOUNT.dkr.ecr.YOUR_REGION.amazonaws.com/ml-api:latest\",\n",
    "            \"portMappings\": [\n",
    "                {\n",
    "                    \"containerPort\": 5000,\n",
    "                    \"protocol\": \"tcp\"\n",
    "                }\n",
    "            ],\n",
    "            \"essential\": True,\n",
    "            \"logConfiguration\": {\n",
    "                \"logDriver\": \"awslogs\",\n",
    "                \"options\": {\n",
    "                    \"awslogs-group\": \"/ecs/ml-api\",\n",
    "                    \"awslogs-region\": \"YOUR_REGION\",\n",
    "                    \"awslogs-stream-prefix\": \"ecs\"\n",
    "                }\n",
    "            },\n",
    "            \"environment\": [\n",
    "                {\n",
    "                    \"name\": \"FLASK_ENV\",\n",
    "                    \"value\": \"production\"\n",
    "                }\n",
    "            ],\n",
    "            \"healthCheck\": {\n",
    "                \"command\": [\n",
    "                    \"CMD-SHELL\",\n",
    "                    \"curl -f http://localhost:5000/health || exit 1\"\n",
    "                ],\n",
    "                \"interval\": 30,\n",
    "                \"timeout\": 5,\n",
    "                \"retries\": 3,\n",
    "                \"startPeriod\": 60\n",
    "            }\n",
    "        }\n",
    "    ]\n",
    "}\n",
    "\n",
    "# Save ECS task definition\n",
    "with open('ecs-task-definition.json', 'w') as f:\n",
    "    json.dump(ecs_task_definition, f, indent=2)\n",
    "\n",
    "print(\"✅ ECS task definition created!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create AWS deployment script\n",
    "aws_deploy_script = '''\n",
    "#!/bin/bash\n",
    "\n",
    "# AWS ECS deployment script\n",
    "\n",
    "set -e\n",
    "\n",
    "# Configuration\n",
    "AWS_REGION=\"us-west-2\"\n",
    "ECR_REPOSITORY=\"ml-api\"\n",
    "ECS_CLUSTER=\"ml-cluster\"\n",
    "ECS_SERVICE=\"ml-api-service\"\n",
    "TASK_DEFINITION=\"ml-api-task\"\n",
    "\n",
    "echo \"🚀 Starting AWS ECS deployment...\"\n",
    "\n",
    "# Get AWS account ID\n",
    "AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)\n",
    "ECR_URI=\"${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}\"\n",
    "\n",
    "echo \"📦 Building and pushing Docker image to ECR...\"\n",
    "\n",
    "# Login to ECR\n",
    "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_URI}\n",
    "\n",
    "# Build and tag image\n",
    "docker build -t ${ECR_REPOSITORY} .\n",
    "docker tag ${ECR_REPOSITORY}:latest ${ECR_URI}:latest\n",
    "\n",
    "# Push image\n",
    "docker push ${ECR_URI}:latest\n",
    "\n",
    "echo \"📋 Registering task definition...\"\n",
    "\n",
    "# Update task definition with correct image URI\n",
    "sed \"s|YOUR_ACCOUNT.dkr.ecr.YOUR_REGION.amazonaws.com/ml-api:latest|${ECR_URI}:latest|g\" ecs-task-definition.json > ecs-task-definition-updated.json\n",
    "sed -i \"s|YOUR_ACCOUNT|${AWS_ACCOUNT_ID}|g\" ecs-task-definition-updated.json\n",
    "sed -i \"s|YOUR_REGION|${AWS_REGION}|g\" ecs-task-definition-updated.json\n",
    "\n",
    "# Register task definition\n",
    "aws ecs register-task-definition --cli-input-json file://ecs-task-definition-updated.json\n",
    "\n",
    "echo \"🔄 Updating ECS service...\"\n",
    "\n",
    "# Update service\n",
    "aws ecs update-service \\\n",
    "    --cluster ${ECS_CLUSTER} \\\n",
    "    --service ${ECS_SERVICE} \\\n",
    "    --task-definition ${TASK_DEFINITION} \\\n",
    "    --force-new-deployment\n",
    "\n",
    "echo \"⏳ Waiting for deployment to complete...\"\n",
    "\n",
    "# Wait for service to stabilize\n",
    "aws ecs wait services-stable \\\n",
    "    --cluster ${ECS_CLUSTER} \\\n",
    "    --services ${ECS_SERVICE}\n",
    "\n",
    "echo \"✅ Deployment completed successfully!\"\n",
    "\n",
    "# Get service endpoint\n",
    "LOAD_BALANCER_DNS=$(aws elbv2 describe-load-balancers \\\n",
    "    --query \"LoadBalancers[?contains(LoadBalancerName, 'ml-api')].DNSName\" \\\n",
    "    --output text)\n",
    "\n",
    "if [ ! -z \"$LOAD_BALANCER_DNS\" ]; then\n",
    "    echo \"🌐 API endpoint: http://${LOAD_BALANCER_DNS}\"\n",
    "fi\n",
    "'''\n",
    "\n",
    "with open('deploy-aws.sh', 'w') as f:\n",
    "    f.write(aws_deploy_script.strip())\n",
    "\n",
    "os.chmod('deploy-aws.sh', 0o755)\n",
    "\n",
    "print(\"✅ AWS deployment script created!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🌐 Google Cloud Platform Deployment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create GCP Cloud Run deployment configuration\n",
    "gcp_service_yaml = '''\n",
    "apiVersion: serving.knative.dev/v1\n",
    "kind: Service\n",
    "metadata:\n",
    "  name: ml-api\n",
    "  annotations:\n",
    "    run.googleapis.com/ingress: all\n",
    "    run.googleapis.com/execution-environment: gen2\n",
    "spec:\n",
    "  template:\n",
    "    metadata:\n",
    "      annotations:\n",
    "        autoscaling.knative.dev/maxScale: \"10\"\n",
    "        autoscaling.knative.dev/minScale: \"1\"\n",
    "        run.googleapis.com/cpu-throttling: \"false\"\n",
    "        run.googleapis.com/memory: \"512Mi\"\n",
    "        run.googleapis.com/cpu: \"1\"\n",
    "    spec:\n",
    "      containerConcurrency: 100\n",
    "      timeoutSeconds: 300\n",
    "      containers:\n",
    "      - image: gcr.io/YOUR_PROJECT_ID/ml-api:latest\n",
    "        ports:\n",
    "        - containerPort: 5000\n",
    "        env:\n",
    "        - name: FLASK_ENV\n",
    "          value: production\n",
    "        resources:\n",
    "          limits:\n",
    "            cpu: \"1\"\n",
    "            memory: \"512Mi\"\n",
    "        livenessProbe:\n",
    "          httpGet:\n",
    "            path: /health\n",
    "            port: 5000\n",
    "          initialDelaySeconds: 30\n",
    "          periodSeconds: 30\n",
    "          timeoutSeconds: 5\n",
    "        readinessProbe:\n",
    "          httpGet:\n",
    "            path: /health\n",
    "            port: 5000\n",
    "          initialDelaySeconds: 10\n",
    "          periodSeconds: 10\n",
    "          timeoutSeconds: 5\n",
    "'''\n",
    "\n",
    "with open('gcp-service.yaml', 'w') as f:\n",
    "    f.write(gcp_service_yaml.strip())\n",
    "\n",
    "print(\"✅ GCP Cloud Run service configuration created!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create GCP deployment script\n",
    "gcp_deploy_script = '''\n",
    "#!/bin/bash\n",
    "\n",
    "# GCP Cloud Run deployment script\n",
    "\n",
    "set -e\n",
    "\n",
    "# Configuration\n",
    "PROJECT_ID=\"your-project-id\"\n",
    "REGION=\"us-central1\"\n",
    "SERVICE_NAME=\"ml-api\"\n",
    "IMAGE_NAME=\"ml-api\"\n",
    "\n",
    "echo \"🚀 Starting GCP Cloud Run deployment...\"\n",
    "\n",
    "# Set project\n",
    "gcloud config set project ${PROJECT_ID}\n",
    "\n",
    "echo \"📦 Building and pushing Docker image to Container Registry...\"\n",
    "\n",
    "# Configure Docker for GCR\n",
    "gcloud auth configure-docker\n",
    "\n",
    "# Build and tag image\n",
    "docker build -t ${IMAGE_NAME} .\n",
    "docker tag ${IMAGE_NAME} gcr.io/${PROJECT_ID}/${IMAGE_NAME}:latest\n",
    "\n",
    "# Push image\n",
    "docker push gcr.io/${PROJECT_ID}/${IMAGE_NAME}:latest\n",
    "\n",
    "echo \"🚀 Deploying to Cloud Run...\"\n",
    "\n",
    "# Update service configuration with project ID\n",
    "sed \"s|YOUR_PROJECT_ID|${PROJECT_ID}|g\" gcp-service.yaml > gcp-service-updated.yaml\n",
    "\n",
    "# Deploy to Cloud Run\n",
    "gcloud run services replace gcp-service-updated.yaml \\\n",
    "    --region=${REGION}\n",
    "\n",
    "# Allow unauthenticated access\n",
    "gcloud run services add-iam-policy-binding ${SERVICE_NAME} \\\n",
    "    --region=${REGION} \\\n",
    "    --member=\"allUsers\" \\\n",
    "    --role=\"roles/run.invoker\"\n",
    "\n",
    "echo \"✅ Deployment completed successfully!\"\n",
    "\n",
    "# Get service URL\n",
    "SERVICE_URL=$(gcloud run services describe ${SERVICE_NAME} \\\n",
    "    --region=${REGION} \\\n",
    "    --format=\"value(status.url)\")\n",
    "\n",
    "echo \"🌐 API endpoint: ${SERVICE_URL}\"\n",
    "echo \"🧪 Test health check: curl ${SERVICE_URL}/health\"\n",
    "'''\n",
    "\n",
    "with open('deploy-gcp.sh', 'w') as f:\n",
    "    f.write(gcp_deploy_script.strip())\n",
    "\n",
    "os.chmod('deploy-gcp.sh', 0o755)\n",
    "\n",
    "print(\"✅ GCP deployment script created!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🔄 CI/CD Pipeline with GitHub Actions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create GitHub Actions workflow\n",
    "github_workflow = '''\n",
    "name: Deploy ML API\n",
    "\n",
    "on:\n",
    "  push:\n",
    "    branches: [ main ]\n",
    "  pull_request:\n",
    "    branches: [ main ]\n",
    "\n",
    "env:\n",
    "  PROJECT_ID: ${{ secrets.GCP_PROJECT_ID }}\n",
    "  SERVICE_NAME: ml-api\n",
    "  REGION: us-central1\n",
    "\n",
    "jobs:\n",
    "  test:\n",
    "    runs-on: ubuntu-latest\n",
    "    \n",
    "    steps:\n",
    "    - uses: actions/checkout@v3\n",
    "    \n",
    "    - name: Set up Python\n",
    "      uses: actions/setup-python@v4\n",
    "      with:\n",
    "        python-version: '3.9'\n",
    "    \n",
    "    - name: Install dependencies\n",
    "      run: |\n",
    "        python -m pip install --upgrade pip\n",
    "        pip install -r requirements.txt\n",
    "        pip install pytest\n",
    "    \n",
    "    - name: Run tests\n",
    "      run: |\n",
    "        pytest tests/ -v\n",
    "    \n",
    "    - name: Lint code\n",
    "      run: |\n",
    "        pip install flake8\n",
    "        flake8 app.py --max-line-length=88\n",
    "\n",
    "  deploy:\n",
    "    needs: test\n",
    "    runs-on: ubuntu-latest\n",
    "    if: github.ref == 'refs/heads/main'\n",
    "    \n",
    "    steps:\n",
    "    - uses: actions/checkout@v3\n",
    "    \n",
    "    - name: Setup Google Cloud CLI\n",
    "      uses: google-github-actions/setup-gcloud@v1\n",
    "      with:\n",
    "        service_account_key: ${{ secrets.GCP_SA_KEY }}\n",
    "        project_id: ${{ secrets.GCP_PROJECT_ID }}\n",
    "    \n",
    "    - name: Configure Docker for GCR\n",
    "      run: gcloud auth configure-docker\n",
    "    \n",
    "    - name: Build and push Docker image\n",
    "      run: |\n",
    "        docker build -t gcr.io/$PROJECT_ID/$SERVICE_NAME:$GITHUB_SHA .\n",
    "        docker push gcr.io/$PROJECT_ID/$SERVICE_NAME:$GITHUB_SHA\n",
    "    \n",
    "    - name: Deploy to Cloud Run\n",
    "      run: |\n",
    "        gcloud run deploy $SERVICE_NAME \\\n",
    "          --image gcr.io/$PROJECT_ID/$SERVICE_NAME:$GITHUB_SHA \\\n",
    "          --region $REGION \\\n",
    "          --platform managed \\\n",
    "          --allow-unauthenticated \\\n",
    "          --memory 512Mi \\\n",
    "          --cpu 1 \\\n",
    "          --max-instances 10 \\\n",
    "          --min-instances 1\n",
    "    \n",
    "    - name: Get service URL\n",
    "      run: |\n",
    "        SERVICE_URL=$(gcloud run services describe $SERVICE_NAME \\\n",
    "          --region=$REGION \\\n",
    "          --format=\"value(status.url)\")\n",
    "        echo \"Service deployed at: $SERVICE_URL\"\n",
    "    \n",
    "    - name: Run smoke tests\n",
    "      run: |\n",
    "        SERVICE_URL=$(gcloud run services describe $SERVICE_NAME \\\n",
    "          --region=$REGION \\\n",
    "          --format=\"value(status.url)\")\n",
    "        \n",
    "        # Test health endpoint\n",
    "        curl -f $SERVICE_URL/health\n",
    "        \n",
    "        # Test prediction endpoint\n",
    "        curl -X POST $SERVICE_URL/predict \\\n",
    "          -H \"Content-Type: application/json\" \\\n",
    "          -d '{\"features\": {\"feature_0\": 1.0, \"feature_1\": 2.0, \"feature_2\": 3.0, \"feature_3\": 4.0, \"feature_4\": 5.0, \"feature_5\": 6.0, \"feature_6\": 7.0, \"feature_7\": 8.0, \"feature_8\": 9.0, \"feature_9\": 10.0}}'\n",
    "'''\n",
    "\n",
    "# Create .github/workflows directory\n",
    "os.makedirs('.github/workflows', exist_ok=True)\n",
    "\n",
    "with open('.github/workflows/deploy.yml', 'w') as f:\n",
    "    f.write(github_workflow.strip())\n",
    "\n",
    "print(\"✅ GitHub Actions workflow created!\")"
   ]
  },
